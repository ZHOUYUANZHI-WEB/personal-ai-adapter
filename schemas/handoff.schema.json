{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZHOUYUANZHI-WEB/personal-ai-adapter/main/schemas/handoff.schema.json",
  "title": "Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "created_at",
    "from_agent",
    "project",
    "objective",
    "current_state",
    "completed",
    "remaining",
    "artifacts",
    "decisions",
    "risks",
    "required_permissions"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "type": { "const": "handoff" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "from_agent": { "$ref": "common.schema.json#/$defs/actor" },
    "recommended_next_agent": { "$ref": "common.schema.json#/$defs/actor" },
    "project": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9._:-]*$"
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "current_state": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "completed": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "remaining": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "uniqueItems": true,
      "maxItems": 100
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
